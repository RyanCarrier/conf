// Waybar config (Tokyo Night, tight pills)
{
	"layer": "top",
	"position": "top",
	"height": 26,
	"spacing": 0,
	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["hyprland/window"],
	"modules-right": ["group/right", "tray"],
	"group/right": {
		"orientation": "horizontal",
		"modules": [
			"backlight",
			"custom/wl-gammarelay-temperature-rs",
			"network",
			"custom/latency",
			"pulseaudio",
			"battery",
			"custom/charge",
			"custom/caffeine",
			"clock"
		]
	},
	"clock": {
		"format": "{:%I:%M%p  %d/%m/%y}",
		"format-alt": "{:%a %d %B %Y}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"format": {
				"today": "<span color='#7aa2f7'><b>{}</b></span>",
				"weekdays": "<span color='#565f89'>{}</span>"
			}
		}
	},
	"custom/wl-gammarelay-temperature-rs": {
		"format": " {}",
		"exec": "wl-gammarelay-rs watch {t}",
		"on-scroll-up": "busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n +25",
		"on-scroll-down": "busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n -25",
		"on-click": "~/.config/waybar/scripts/temperature-cycle.sh",
		"on-click-right": "~/.config/waybar/scripts/temperature-cycle.sh warm"
	},
	"hyprland/window": {
		"max-length": 80,
		"separate-outputs": true,
		"rewrite": {
			"(.*) - Google Chrome": "$1 -  ",
			"(.*) — Konsole": "$1 -  ",
			"t": "tmux -  "
		}
	},
	"hyprland/workspaces": {
		"persistent-workspaces": {
			"eDP-1": [1, 2, 3, 4, 5],
			"DP-3": [3, 4]
		},
		"disable-scroll": true,
		"all-outputs": false,
		"on-click": "activate",
		"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
		"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
	},
	"battery": {
		"states": { "warning": 30, "critical": 15 },
		"format": "{icon} {capacity}%",
		"format-charging": "󰂄 {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{icon} {time}",
		"format-icons": ["", "", "", "", ""],
		"tooltip-format": "{timeTo}\n{power:.1f} W"
	},
	"network": {
		"format-wifi": "{icon} {essid}",
		"format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
		"format-ethernet": "󰈀 wired",
		"format-linked": "󰈀 {ifname} (no IP)",
		"format-disconnected": "󰤭 offline",
		"max-length": 18,
		"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
		"format-alt": "󰈀 {ipaddr}/{cidr}",
		"on-click-right": "nm-connection-editor"
	},
	"tray": { "icon-size": 16, "spacing": 6 },
	"backlight": {
		"format": "{icon} {percent}%",
		"format-icons": ["", "", "", "", "", "", "", "", ""],
		"on-click": "~/.config/waybar/scripts/brightness-cycle.sh",
		"on-click-right": "~/.config/waybar/scripts/brightness-cycle.sh min"
	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰝟 muted",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"default": ["", "", ""]
		},
		"on-click": "pamixer --toggle-mute"
	},
	"custom/latency": {
		"exec": "~/.config/waybar/scripts/latency.sh",
		"return-type": "json",
		"format": "{}"
	},
	"custom/charge": {
		"format": "{}",
		"exec": "~/.config/waybar/scripts/charge-status.sh",
		"on-click": "~/.config/waybar/scripts/charge-toggle.sh",
		"interval": 60,
		"signal": 9,
		"return-type": "json"
	},
	"custom/caffeine": {
		"format": "{}",
		"exec": "~/.config/waybar/scripts/caffeine-status.sh",
		"on-click": "~/.config/waybar/scripts/caffeine-toggle.sh",
		"interval": 2,
		"return-type": "json"
	}
}
